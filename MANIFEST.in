# The Python wheel owns the existing cmpct-core cdylib. Source distributions must therefore carry the
# exact locked Rust build graph rather than relying on a repository checkout that users will not have.
include native/cmpct-core/Cargo.toml
include native/cmpct-core/Cargo.lock
recursive-include native/cmpct-core/src *.rs
# Optional stable-ABI accelerator must survive sdist-to-wheel builds without a checkout.
include src/cmpct/_fastscan_abi3.c
